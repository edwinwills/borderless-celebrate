# ── The paper ────────────────────────────────────────────────
PAPER_NAME="The Borderless Bugle"
PAPER_MOTTO="All the code that's fit to ship"
# One line of context so headlines make sense to the whole office
COMPANY_CONTEXT="Borderless is a UK platform that helps employers sponsor and hire overseas workers (sponsor licences, CoS, Skilled Worker visas)."

# ── GitHub ───────────────────────────────────────────────────
# Fine-grained token with read access to Actions, Contents, Deployments (and Metadata)
GITHUB_TOKEN=
# Comma-separated. Each entry is one of:
#   owner/repo:actions:<workflow file>     successful workflow runs = a deploy
#   owner/repo:deployments:<environment>   GitHub Deployments API, status "success"
#   owner/repo:releases                    published GitHub Releases
# deploy-prod.yml runs on push to `prod`; promotions run under deploy-preprod-to-prod.yml
GITHUB_SOURCES=getborderless/borderless:actions:deploy-prod.yml,getborderless/borderless:actions:deploy-preprod-to-prod.yml

# ── Linear ───────────────────────────────────────────────────
# Personal API key (Settings → Security & access → API keys). Used to turn
# BDLS-123 references into real ticket titles, assignees and screenshots.
LINEAR_API_KEY=
# Only ticket IDs with these team keys are looked up (stops "UTF-8" looking like a ticket)
LINEAR_TEAM_KEYS=BDLS,OPE
# Optional: also celebrate when tickets move into these states (comma-separated).
# Leave blank if GitHub deploys are your source of truth, otherwise tickets
# get celebrated on merge instead of when they actually go live.
LINEAR_WATCH_STATES=

# ── Headlines ────────────────────────────────────────────────
# Optional. Without it, headlines come from a (less funny) template.
ANTHROPIC_API_KEY=

# ── Behaviour ────────────────────────────────────────────────
PORT=8787
POLL_SECONDS=60
# How long a new release takes over the screen before it rejoins the rotation
CELEBRATE_SECONDS=90
# How many past deploys to backfill on first run so the screen isn't empty
BACKFILL=5
# ...but nothing older than this many days
BACKFILL_DAYS=14
# Password-protect the whole app (strongly recommended anywhere but your own laptop)
BASIC_AUTH_USER=bugle
BASIC_AUTH_PASSWORD=
# Where editions are saved. Point this at a persistent volume when hosted.
DATA_DIR=data
# Shared secret for POST /api/announce (leave blank to disable that endpoint)
ANNOUNCE_TOKEN=
# Fill the paper with made-up stories, no tokens needed
DEMO=false
